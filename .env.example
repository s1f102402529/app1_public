# Replace these placeholders with different, randomly generated local values.
DJANGO_SECRET_KEY=replace-with-a-random-secret
POSTGRES_PASSWORD=replace-with-a-different-random-password

# Show the read-only demo account buttons on the login page.
DEMO_ACCOUNTS_ENABLED=true

# Optional: leave empty to run the app without AI advice.
AI_API_KEY=

# Optional: defaults to gpt-6-luna when empty or unset.
AI_MODEL=gpt-6-luna

# AI_API_URL is currently configured directly in docker-compose.yml,
# so a value here would not override the Compose service configuration.
